# Required
MEDIA_DIR=/path/to/your/media
BOOK_BACKEND=kavita
KAVITA_API_KEY=your_kavita_api_key

# Optional
# LE_GRIMOIRE_SERVER_HOST=127.0.0.1
# LE_GRIMOIRE_SERVER_PORT=8080
# KAVITA_BASE_URL=http://kavita:5000

# Options for CHROME_PATH:
# 1. CHROME_REMOTE_URL (Remote headless container/instance)
# 2. CHROME_PATH (Local custom binary)
# 3. Default (Chromedp auto-discovers local Chrome/Chromium)
CHROME_REMOTE_URL=http://headless-shell:9222
# CHROME_PATH=/path/to/chrome
# LE_GRIMOIRE_DATA_DIR=~/.config/le-grimoire
